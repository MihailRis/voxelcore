<panel size='480' color='#00000030' context='menu' interval='4'>
    <label align='center' margin='2'>@Progress-bars</label>

    <label>Static</label>
    <progressbar id='st_blue' size='300,14' value='70'/>
    <progressbar id='st_red' size='300,14' value='35' color='#FF4040' bg-color='#00000060'/>
    <progressbar id='st_green' size='300,14' value='90' color='#40FF40' bg-color='#00000060'/>

    <label>Vertical</label>
    <panel orientation='horizontal' size='180,110' interval='10' color='0'>
        <progressbar id='v_red' orientation='vertical' size='18,110' value='60' color='#FF8040'/>
        <progressbar id='v_green' orientation='vertical' size='18,110' value='80' color='#40FF40'/>
        <progressbar id='v_blue' orientation='vertical' size='18,110' value='25' color='#4080FF'/>
    </panel>

    <label>Backgrounds</label>
    <progressbar id='bg_none' size='300,14' value='70' color='#FFA040' bg-color='0'/>
    <progressbar id='bg_white' size='300,14' value='35' color='#FF4040' bg-color='#FFFFFF40'/>
    <progressbar id='bg_blue' size='300,14' value='90' color='#40FF40' bg-color='#2040A0C0'/>

    <label>Dynamic</label>
    <progressbar id='dyn_off' size='300,14' value='0' smooth='false' color='#FF4040' bg-color='#00000060'/>
    <progressbar id='dyn_slow' size='300,14' value='0' smooth='true' smooth-speed='60' color='#FFA040' bg-color='#00000060'/>
    <progressbar id='dyn_fast' size='300,14' value='0' smooth='true' smooth-speed='400' color='#40FF40' bg-color='#00000060'/>

    <button onclick='menu:back()'>@Back</button>
</panel>
